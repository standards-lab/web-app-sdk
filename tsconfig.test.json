// The tests' type-check, mise run types:test, which never emits.
// See docs/development.md
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["test/**/*.ts"]
}
